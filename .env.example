# Copy to .env and fill in from your Supabase project:
# Dashboard -> Project Settings -> API Keys
#
# Use the anon / publishable key (labelled "Publishable key" on newer projects).
# Never use the service_role / secret key in a frontend app.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only needed if you run Supabase CLI migrations yourself.
# Not VITE_-prefixed on purpose, so it stays out of the browser bundle.
SUPABASE_DB_PASSWORD=
